nsform":"none","align":"center","isShadowUsed":false,"shadowOffsetX":"3","shadowOffsetY":"3","shadowBlur":"3","shadowColor":{"red":"0","green":"0","blue":"0","alpha":"0.2"}},"border":{"isUsed":false,"width":"1","color":{"red":"255","green":"255","blue":"255","alpha":"1"},"radius":"0"},"background":{"isUsed":true,"color":{"red":"0","green":"0","blue":"0","alpha":"1"}},"arc":{"isUsed":false,"type":"fill","radius":"16","startAngle":"0","sweepAngle":"360","strokeWidth":"0","color":{"red":"255","green":"255","blue":"255","alpha":"1"}},"image":{"isUsed":false,"dimension":{"width":0,"height":0},"resource":"","size":"contain"},"multipleImage":{"isUsed":false,"dimension":{"width":0,"height":0},"resourceList":[],"size":"contain","index":"0"},"position":{"left":"0","top":"0"},"dimension":{"width":"450","height":"450"},"opacity":"0.3","transform":{"scale":"1","rotate":"0"},"ambient":"1","invisible":"1"}],"targetDevice":"android-heartbl","updatedAt":"2023-09-21T08:47:47.601Z","createdAt":"2023-08-30T22:01:22.935Z","images":{"preview":"/watches/EuZAuNRteH/preview?updatedAt=1695286067601","previewSmall":"/watches/EuZAuNRteH/preview-small?updatedAt=1695286067601"},"__v":6,"category":{"_id":"60e54cc4e009a03d3f190d6d","name":"digital"},"components":[],"descriptionI18n":{"ko":"#주요 기능\n\n[시간 & 날짜]\n - 디지털 시계\n - 12/24시간 포맷 지원\n\n[디바이스 정보]\n - 배터리 잔량\n\n[헬스  정보]\n - 현재까지 걸음 수(삼성 헬스)\n - 심박수(BPM)\n\n[날씨 정보]\n - 날씨\n - 기온(C, F)\n\n[기타]\n - Alway on Display\n\n타임플릭 오리지널 워치페이스\n\n오리지널 워치페이스는 포인트로 구매 후 영구 소장하거나, 정기 구독 후 대여하여 사용할 수 있습니다.\n적용한 워치페이스는 마이페이지의 최근 적용 또는 소장 목록에서 확인하실 수 있어요.\n정기 구독 중 워치페이스를 이용하는 경우, 구독이 만료되면 워치페이스를 더 이상 적용할 수 없음에 유의해 주세요.","en":"#Features\n\n[Time & Date]\n - Digital Time\n - 12/24 Hour Format\n \n[Device]\n - Watch Battery\n\n[Health]\n - Steps Count (Samsung Health)\n - Heart Rate(BPM)\n\n[Weather]\n - Current Weather\n - Temperature(C, F)\n\n[Etc.]\n - Alway on Display\n\nTIMEFLIK Original Watch Face\n\nThis watch face can be applied when you purchase it in points or rent it while subscribing.\nYou can find purchased watch faces on My Page > [Purchased watch face].\nA watch face purchased in points can be permanently owned. On the other hand, a rented watch face during a subscription can only be applied during an active subscription period.","ja":"主な機能\n\n[時間&日付]\n- デジタル時計\n- 12/24時間フォーマット対応\n\n[デバイス情報]\n- バッテリー残量\n\n[ヘルス情報]\n- 現在までの歩数（SAMSUNGヘルス）\n- 心拍数(BPM)\n\n[天気情報]\n- 天気\n- 気温(C, F)\n\n\n[その他]\n- 常に表示\n\nタイムフリックオリジナル文字盤\n\nオリジナル文字盤はポイントで購入した後に永久使用するか、\nサブスク決済でレンタルして使用できます。\nダウンロードした文字盤はマイページの最近の適用または\n購入した文字盤からご確認できます。\nサブスク中に文字盤を利用する場合、購読が満了すると文字盤の使用は\nできないことに注意してください。"},"watchSell":{"currentAmount":750,"detailWallpaperImageUrl":null,"descImages":[],"originalAmount":750,"atDiscount":false,"isHidden":false,"isCollaboration":false,"onlyEvent":false,"exclusiveCountries":[],"isLimited":false,"sellTypes":["NORMAL"],"_id":"65002f1d7e5860c30fe0189c","watchSellId":"Iz1xluNlG1","title":"Nostalgic System(W)","titleI18n":{"ko":"","en":"","ja":""},"watchPosition":4,"updatedAt":"2023-12-26T11:22:31.548Z","createdAt":"2023-09-12T09:27:57.153Z","purchased":false,"wallpaperImageUrl":null,"smallListWallpaperImageUrl":null,"listWallpaperImageUrl":null,"premiumSubscribeAmount":750,"liteSubscribeAmount":750,"todayAvailableForSubscription":false},"seriesId":"vSAQu6h4KA","descriptionImages":null,"descriptionLink":null,"descriptionTitle":null,"descriptionLinkTitle":null,"hasHealthData":true,"favorite":681,"comments":1,"commentList":[{"content":"Where's the date?","_id":"65028eb167b2ea06b92df969","watchCommentId":"1gs0GUVL8L","user":{"nickname":"宮崎真","_id":"617cebf007be9511061ee586","userId":"Q6eajaaZJq","thumbnail":"/api/users/Q6eajaaZJq/thumbnail?updatedAt="},"createdAt":"2023-09-14T04:40:17.700Z"}],"inFavorites":false}