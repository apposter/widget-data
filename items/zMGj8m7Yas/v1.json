,"dimension":{"width":"83","height":"20"},"resourceList":[],"size":"contain","index":"0"},"position":{"left":"50","top":"268"},"dimension":{"width":"83","height":"20"},"opacity":"1","transform":{"scale":"1","rotate":"0"},"ambient":"if(#BLN#<10,1,0)","invisible":"if(#BLN#<10,0,1)"}],"targetDevice":"samsung-galaxy-watch3","updatedAt":"2021-02-18T07:14:56.853Z","createdAt":"2021-02-18T07:14:56.853Z","images":{"preview":"/watches/zMGj8m7Yas/preview?updatedAt=1613632496853","previewSmall":"/watches/zMGj8m7Yas/preview-small?updatedAt=1613632496853"},"__v":14,"components":[],"category":{"_id":"60e54ce9e009a03d3f190e25","name":"informative"},"watchSell":{"currentAmount":350,"detailWallpaperImageUrl":null,"descImages":[],"originalAmount":350,"atDiscount":false,"isHidden":false,"isCollaboration":false,"onlyEvent":false,"exclusiveCountries":[],"isLimited":false,"sellTypes":["NORMAL"],"_id":"60383b4b4cceda0eb5ffaf5a","watchSellId":"12YH9tNJsr","title":"Waders A1  |  ADESTON","watchPosition":4,"updatedAt":"2023-07-08T15:39:26.883Z","createdAt":"2021-02-26T00:05:31.796Z","titleI18n":{"ko":"","en":"","ja":""},"purchased":false,"wallpaperImageUrl":null,"smallListWallpaperImageUrl":null,"listWallpaperImageUrl":null,"premiumSubscribeAmount":350,"liteSubscribeAmount":350,"todayAvailableForSubscription":false},"descriptionI18n":{"ko":"#타임플릭 오리지널 워치페이스\n\n오리지널 워치페이스는 포인트로 구매 후 영구 소장하거나, 정기 구독 후 대여하여 사용할 수 있어요.\n적용한 워치페이스는 마이페이지의 최근 적용 또는 소장 목록에서 확인하실 수 있어요.\n정기 구독 중 워치페이스를 이용하는 경우, 구독이 만료되면 워치페이스를 더 이상 적용할 수 없음에 유의해 주세요.\n\n#주요기능\n\n[시간 & 날짜]\n - 디지털 시계\n - 12/24시간 포맷 지원\n - 날짜\n\n[디바이스 정보]\n - 배터리 잔량\n\n[헬스  정보]\n - 현재까지 걸음 수(삼성 헬스)\n - 소비 칼로리\n\n[기타]\n - Alway on Display\n\n#주의사항\n\n - 날씨 및 헬스 정보는 타임플릭 모바일 앱과 워치 앱에서 설정할 수 있어요.\n - 날씨 및 헬스 정보가 표시되지 않으면 워치 앱에서 위치 정보와 센서의 접근 권한이 허용되어 있는지 확인해 주세요.","en":"#TIMEFLIK Original Watch Face\n\nThis watch face can be applied when you purchase it in points or rent it while subscribing.\nYou can find purchased watch faces on My Page > [Purchased watch face].\nA watch face purchased in points can be permanently owned. On the other hand, a rented watch face during a subscription can only be applied during an active subscription period.\n\n#Features\n\n[Time & Date]\n - Digital Time\n - 12/24 Hour Format\n - Date\n\n[Device]\n - Watch Battery\n\n[Health]\n - Steps Count (Samsung Health)\n - Calories \n\n[Etc.]\n - Alway on Display\n\n#Notice\n\n - Weather and health information can be set in the TIMEFLIK mobile & watch app.\n - Be sure to allow access to the location and sensor in the watch app to display the weather and health information.","ja":"#タイムフリックオリジナル文字盤\n\nオリジナル文字盤はポイントで購入した後に永久使用するか、サブスク決済でレンタルして使用できます。ダウンロードした文字盤はマイページの最近適用または購入した文字盤からご確認できます。サブスク中に文字盤を利用する場合、購読が満了すると文字盤の使用はできないことに注意してください。\n\n#ご案内\n\n - 天気およびヘルス情報はタイムフリックアプリとウォッチアプリで設定できます。\n - 天気やヘルス情報が表示されない場合は、ウォッチアプリで位置情報と\nセンサーのアクセス権限が許可されていることを確認してください。"},"seriesId":null,"descriptionImages":null,"descriptionLink":null,"descriptionTitle":null,"descriptionLinkTitle":null,"hasHealthData":true,"favorite":214,"comments":1,"commentList":[{"content":"녹색과 주황색이 시안과 달리 좌우가 바뀌어 나옵니다\n그리고 걸음수와 칼로리가 맞지않습니다","_id":"61a888a38a54ac5ada623832","watchCommentId":"KdHkZXUyZK","user":{"nickname":"MJ K","_id":"61a82f0c6570c0613c979dcc","userId":"Cs3BpxKbN6","updatedAt":"2025-03-27T00:27:24.010Z","thumbnail":"/api/users/Cs3BpxKbN6/thumbnail?updatedAt=1743035244010"},"createdAt":"2021-12-02T08:49:39.044Z"}],"inFavorites":false}